{
  "name": "ai-testing-assistant",
  "displayName": "AI Codebase-Aware Testing Assistant",
  "description": "Codebase-aware AI test case generator, test runner, and Playwright assistant for VS Code.",
  "version": "0.1.0",
  "publisher": "ai-testing",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Machine Learning"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-testing-sidebar",
          "title": "AI Testing",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ai-testing-sidebar": [
        {
          "id": "aiTestingExplorer",
          "name": "Testing Workspace Explorer"
        },
        {
          "id": "aiTestingSuggestedCases",
          "name": "AI Suggested Test Cases"
        }
      ]
    },
    "commands": [
      {
        "command": "aiTesting.scanProject",
        "title": "AI Testing: Scan Project Structure",
        "category": "AI Testing"
      },
      {
        "command": "aiTesting.analyzeCurrentFile",
        "title": "AI Testing: Analyze Current File",
        "category": "AI Testing"
      },
      {
        "command": "aiTesting.generateTestCases",
        "title": "AI Testing: Generate Test Cases for Function",
        "category": "AI Testing"
      },
      {
        "command": "aiTesting.setApiKey",
        "title": "AI Testing: Configure Gemini API Key",
        "category": "AI Testing"
      },
      {
        "command": "aiTesting.runTests",
        "title": "AI Testing: Run Automated Tests",
        "category": "AI Testing"
      },
      {
        "command": "aiTesting.selectModel",
        "title": "AI Testing: Switch Gemini Model",
        "category": "AI Testing"
      },
      {
        "command": "aiTesting.analyzeImpact",
        "title": "AI Testing: Analyze Changed Code Impact",
        "category": "AI Testing"
      },
      {
        "command": "aiTesting.runImpactedTests",
        "title": "AI Testing: Run Impacted Tests Only",
        "category": "AI Testing"
      },
      {
        "command": "aiTesting.generateTraceabilityMatrix",
        "title": "AI Testing: Generate Traceability Matrix",
        "category": "AI Testing"
      },
      {
        "command": "aiTesting.exportDefectReport",
        "title": "AI Testing: Export Defect Report",
        "category": "AI Testing"
      },
      {
        "command": "aiTesting.repairFailingTest",
        "title": "AI Testing: Auto-Repair Failing Test",
        "category": "AI Testing"
      },
      {
        "command": "aiTesting.toggleApproval",
        "title": "AI Testing: Toggle Test Case Approval",
        "category": "AI Testing",
        "icon": "$(check)"
      },
      {
        "command": "aiTesting.approveAndGenerateCode",
        "title": "AI Testing: Approve & Generate Test Code",
        "category": "AI Testing",
        "icon": "$(check-all)"
      }
    ],
    "configuration": {
      "title": "AI Testing Assistant",
      "properties": {
        "aiTesting.model": {
          "type": "string",
          "default": "gemini-3.8-flash",
          "enum": [
            "gemini-3.8-flash",
            "gemini-3.5-flash-lite",
            "gemini-3.7-flash",
            "gemini-2.5-flash",
            "gemini-2.0-flash",
            "gemini-1.5-flash"
          ],
          "description": "Gemini model to use for test case generation and failure analysis."
        },
        "aiTesting.testFramework": {
          "type": "string",
          "enum": [
            "playwright",
            "vitest",
            "jest"
          ],
          "default": "vitest",
          "description": "Target test runner framework for test generation."
        },
        "aiTesting.testDirectory": {
          "type": "string",
          "default": "tests/ai-generated",
          "description": "Target directory where generated test files are created."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "aiTesting.approveAndGenerateCode",
          "when": "view == aiTestingSuggestedCases",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aiTesting.toggleApproval",
          "when": "view == aiTestingSuggestedCases && viewItem == aiTestCase",
          "group": "inline"
        },
        {
          "command": "aiTesting.generateTestCases",
          "when": "view == aiTestingExplorer && viewItem == discoveredFunction",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "zod": "^3.22.4"
  }
}
